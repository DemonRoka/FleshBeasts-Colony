<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<FB.FleshRelayDef>
		<defName>FB_FleshRelaySettings</defName>

		<captiveCapacity>6</captiveCapacity>
		<startingCaptives>1~2</startingCaptives>

		<!-- Установку возят только технологичные соседи -->
		<minFactionTechLevel>Industrial</minFactionTechLevel>

		<!-- Облик учёных: пистолет, светлый халат поверх рубахи, шапка по погоде -->
		<scientistWeapons>
			<li>Gun_Autopistol</li>
			<li>Gun_Revolver</li>
		</scientistWeapons>
		<scientistCoats>
			<li>Apparel_Duster</li>
			<li>Apparel_Jacket</li>
		</scientistCoats>
		<scientistColdCoat>Apparel_Parka</scientistColdCoat>
		<scientistHat>Apparel_Tuque</scientistHat>
		<scientistHatChance>0.25</scientistHatChance>
		<scientistCoatColor>(0.93, 0.94, 0.92)</scientistCoatColor>
		<scientistCount>2</scientistCount>
		<scientistMajorPassionChance>0.5</scientistMajorPassionChance>

		<!-- Установка сама по себе не работает: и настройка, и заряд следующего срыва идут
		     только от рук учёных у пульта. Единица работы - тик одного учёного со скоростью
		     исследования 1.0; двое умелых дают около 3.6 за тик, то есть первый срыв примерно
		     через 7500 тиков живого времени, а полная настройка - за половину суток -->
		<breakWorkBase>27000</breakWorkBase>
		<breakWorkMin>9000</breakWorkMin>
		<tuningWork>110000</tuningWork>
		<berserkDurationTicks>2500~5000</berserkDurationTicks>
		<lureChance>0.5</lureChance>

		<maxSimultaneous>2</maxSimultaneous>
		<maxSimultaneousHighPoints>4</maxSimultaneousHighPoints>
		<lureTimeoutTicks>15000</lureTimeoutTicks>
		<!-- Столько времени подряд ловить некого - рейд сворачивается и уходит -->
		<abandonAfterIdleTicks>5000</abandonAfterIdleTicks>

		<!-- Установка после ухода рейда: волна безумия раз в промежуток, до самого слома.
		     По одной твари за волну - одичание необратимо -->
		<waveIntervalTicks>15000</waveIntervalTicks>
		<waveSize>1~1</waveSize>

		<!-- Уходя, налётчики минируют подходы к установке -->
		<mineDef>TrapIED_HighExplosive</mineDef>
		<mineCount>6</mineCount>

		<!-- Пороги ниже, чем у кордона: изучение колонии идёт первым слоем, выжигание вторым -->
		<pressureThreshold>140</pressureThreshold>
		<pressurePerBeast>1.2</pressurePerBeast>
		<pressurePerHundredFleshCells>4</pressurePerHundredFleshCells>
		<maxPressurePerDay>30</maxPressurePerDay>
		<pressureCheckIntervalTicks>2500</pressureCheckIntervalTicks>
		<!-- 20 дней: релей приходит первым слоем, но не чаще одного раза за сезон -->
		<minIntervalTicks>1200000</minIntervalTicks>
		<minColonyBeasts>6</minColonyBeasts>

		<!-- Самая поздняя из особых осад: антенну везут к уже заметной колонии -->
		<earliestDayToFire>35</earliestDayToFire>
		<minThreatPoints>300</minThreatPoints>
	</FB.FleshRelayDef>

</Defs>
