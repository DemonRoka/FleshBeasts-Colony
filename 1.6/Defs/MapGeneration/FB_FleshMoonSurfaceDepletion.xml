<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Мутации тайла: иссушение дикой экосистемы гемогелевой добычей -->
  <TileMutatorDef>
    <defName>FB_FleshTileNutritionStrained</defName>
    <label>strained ecosystem</label>
    <description>Hemogel extraction has thinned the wild plants and animal presence on this tile.</description>
    <categories>
      <li>FleshTileNutrition</li>
    </categories>
    <displayPriority>-40</displayPriority>
    <plantDensityFactor>0.65</plantDensityFactor>
    <animalDensityFactor>0.7</animalDensityFactor>
  </TileMutatorDef>

  <TileMutatorDef>
    <defName>FB_FleshTileNutritionBarren</defName>
    <label>barren ecosystem</label>
    <description>Hemogel extraction has left this tile with sparse wild plants and few animals.</description>
    <categories>
      <li>FleshTileNutrition</li>
    </categories>
    <displayPriority>-40</displayPriority>
    <plantDensityFactor>0.22</plantDensityFactor>
    <animalDensityFactor>0.25</animalDensityFactor>
  </TileMutatorDef>

  <TileMutatorDef>
    <defName>FB_FleshTileNutritionDepleted</defName>
    <label>depleted ecosystem</label>
    <description>Hemogel extraction has nearly stripped this tile of wild plants and animal presence.</description>
    <categories>
      <li>FleshTileNutrition</li>
    </categories>
    <displayPriority>-40</displayPriority>
    <plantDensityFactor>0</plantDensityFactor>
    <animalDensityFactor>0</animalDensityFactor>
    <preventGenSteps>
      <li>Plants</li>
      <li>Animals</li>
    </preventGenSteps>
  </TileMutatorDef>

  <!-- Шаг генерации: FB_GenStep_FleshMoonSurfaceDepletion -->
  <GenStepDef>
    <defName>FB_GenStep_FleshMoonSurfaceDepletion</defName>
    <order>840</order>
    <genStep Class="FB.GenStep_FleshMoonSurfaceDepletion">
      <minimumVisualDepletion>0.01</minimumVisualDepletion>
      <maxWildPlantRemovalChance>0.95</maxWildPlantRemovalChance>
    </genStep>
  </GenStepDef>
</Defs>
