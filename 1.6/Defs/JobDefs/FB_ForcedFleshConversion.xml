<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Носильщик прежней схемы принятия: оставлен ради старых сохранений, задание сразу завершается -->
  <JobDef>
    <defName>FB_ForcedFleshConversionDoctor</defName>
    <driverClass>FB.JobDriver_ForcedFleshConversionDoctor</driverClass>
    <reportString>carrying TargetA.</reportString>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>FB_ForcedFleshConversionFingerspike</defName>
    <driverClass>FB.JobDriver_ForcedFleshConversionFingerspike</driverClass>
    <reportString>implanting itself into TargetB.</reportString>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
  </JobDef>

  <!-- Доброволец прежней схемы принятия: оставлен ради старых сохранений, задание сразу завершается -->
  <JobDef>
    <defName>FB_ForcedFleshConversionVolunteer</defName>
    <driverClass>FB.JobDriver_ForcedFleshConversionVolunteer</driverClass>
    <reportString>accepting the flesh.</reportString>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
</Defs>
