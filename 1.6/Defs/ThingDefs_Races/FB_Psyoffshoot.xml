<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Раса: psyoffshoot (FB_Psyoffshoot) -->
	<ThingDef ParentName="BaseFleshbeast">
		<defName>FB_Psyoffshoot</defName>
		<label>psyoffshoot</label>
		<description>A short-lived sprout of psyphage flesh grown around nerve imprints from its archive. It casts each packed ability once without psylink, psyfocus or neural heat, and withers once they are spent.</description>
		<researchPrerequisites>
			<li>FB_PsyphageGestation</li>
		</researchPrerequisites>
		<hiddenWhileUndiscovered>false</hiddenWhileUndiscovered>
		<tradeability>None</tradeability>
		<statBases>
			<MoveSpeed>4.2</MoveSpeed>
			<ComfyTemperatureMin>-35</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<Flammability>1.2</Flammability>
			<ToxicResistance>0.5</ToxicResistance>
			<MarketValue>150</MarketValue>
			<MeatAmount>10</MeatAmount>
			<ArmorRating_Blunt>0.1</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.12</ArmorRating_Sharp>
			<PsychicSensitivity>1</PsychicSensitivity>
		</statBases>
		<race>
			<body>Fingerspike</body>
			<intelligence>ToolUser</intelligence>
			<specificMeatDef>Meat_Twisted</specificMeatDef>
			<disableIgniteVerb>true</disableIgniteVerb>
			<canOpenFactionlessDoors>true</canOpenFactionlessDoors>
			<bloodDef>Filth_Blood</bloodDef>
			<bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
			<soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
			<trainability>None</trainability>
			<baseBodySize>0.6</baseBodySize>
			<baseHungerRate>0.1</baseHungerRate>
			<baseHealthScale>0.6</baseHealthScale>
			<lifeExpectancy>5</lifeExpectancy>
			<renderTree>Animal</renderTree>
			<thinkTreeMain>FB_FleshbeastStandardMain</thinkTreeMain>
			<thinkTreeConstant>FB_FleshbeastStandardConstant</thinkTreeConstant>
			<needsRest>false</needsRest>
			<hasGenders>false</hasGenders>
			<foodType>None</foodType>
			<canBePredatorPrey>false</canBePredatorPrey>
			<fleshType>Fleshbeast</fleshType>
			<isImmuneToInfections>true</isImmuneToInfections>
			<bleedRateFactor>0.45</bleedRateFactor>
			<hediffGiverSets>
				<li>Fleshbeast</li>
			</hediffGiverSets>
			<deathAction Class="DeathActionProperties_Vanish">
				<workerClass>DeathActionWorker_Vanish</workerClass>
				<filth>Filth_TwistedFlesh</filth>
				<filthCountRange>1~3</filthCountRange>
				<meatExplosionSize>Small</meatExplosionSize>
			</deathAction>
			<lifeStageAges>
				<li>
					<def>EntityFullyFormed</def>
					<soundWounded>Pawn_Fleshbeast_Fingerspike_Wounded</soundWounded>
					<soundDeath>Pawn_Fleshbeast_Fingerspike_Death</soundDeath>
					<soundCall>Pawn_Fleshbeast_Fingerspike_Call</soundCall>
				</li>
			</lifeStageAges>
		</race>
		<comps>
			<li Class="FB.CompProperties_FleshbeastDraftable" />
			<li Class="FB.CompProperties_Psyoffshoot">
				<usesPerAbility>1</usesPerAbility>
			</li>
		</comps>
		<tools>
			<li>
				<label>spike</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>6</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>MiddleSpike</linkedBodyPartsGroup>
				<soundMeleeHit>Pawn_Fleshbeast_Attack_Spike</soundMeleeHit>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>3</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<soundMeleeHit>Pawn_Fleshbeast_Attack_Blunt</soundMeleeHit>
			</li>
		</tools>
	</ThingDef>
</Defs>
