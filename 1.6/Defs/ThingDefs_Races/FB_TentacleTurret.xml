  <!-- Embryo structure: Tentacle Turret Embryo (FB_TentacleTurretEmbryo) -->
  <ThingDef ParentName="EmbryoStructureBase">
    <defName>FB_TentacleTurretEmbryo</defName>
    <label>Tentacle Turret Embryo</label>
    <description>An immature defensive organ that will grow into a tentacle turret.</description>
    <size>(1,1)</size>
    <comps>
      <li Class="FB.CompProperties_EmbryoGrowth">
        <totalMaturationTicks>5000</totalMaturationTicks>
