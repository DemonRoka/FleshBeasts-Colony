  <!-- Body: fleshmass turret body (FB_TentacleTurretBody) -->
  <BodyDef>
    <defName>FB_TentacleTurretBody</defName>
    <label>fleshmass turret body</label>
    <corePart>
      <def>FB_TurretShell</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>FB_TurretCore</def>
          <customLabel>core</customLabel>
          <coverage>0.1</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>FB_TurretGelSac</def>
          <customLabel>gel sac</customLabel>
          <coverage>0.1</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>FB_TurretSensor</def>
          <customLabel>primary sensor</customLabel>
          <coverage>0.05</coverage>
          <depth>Outside</depth>
          <groups>
            <li>Eyes</li>
          </groups>
        </li>
        <li>
          <def>FB_TurretSensor</def>
          <customLabel>secondary sensor</customLabel>
          <coverage>0.05</coverage>
          <depth>Outside</depth>
          <groups>
            <li>Eyes</li>
          </groups>
        </li>
        <li>
          <def>FB_TurretTentacle</def>
          <customLabel>north tentacle</customLabel>
          <coverage>0.15</coverage>
          <depth>Outside</depth>
          <groups>
            <li>Arms</li>
            <li>FB_CoreTentacles</li>
          </groups>
        </li>
        <li>
          <def>FB_TurretTentacle</def>
          <customLabel>south tentacle</customLabel>
          <coverage>0.15</coverage>
          <depth>Outside</depth>
          <groups>
            <li>Arms</li>
            <li>FB_CoreTentacles</li>
          </groups>
        </li>
        <li>
          <def>FB_TurretTentacle</def>
          <customLabel>east tentacle</customLabel>
          <coverage>0.15</coverage>
          <depth>Outside</depth>
          <groups>
            <li>Arms</li>
            <li>FB_CoreTentacles</li>
          </groups>
        </li>
        <li>
          <def>FB_TurretTentacle</def>
          <customLabel>west tentacle</customLabel>
          <coverage>0.15</coverage>
