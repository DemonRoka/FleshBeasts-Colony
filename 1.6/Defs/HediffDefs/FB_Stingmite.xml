<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>FB_FleshParasite</defName>
    <label>flesh parasite</label>
    <description>A fleshbeast larva planted by a stingmite's sting. It does not harm the tissue, but it slowly matures and spreads into neighbouring body parts. Once mature, it tears its body part off and crawls out; a large enough part releases a fingerspike loyal to the colony. It can be removed surgically, and a graftmaw can cut the infected parts out cleanly.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <defaultLabelColor>(0.85, 0.45, 0.55)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>1</severityPerDay>
      </li>
      <li Class="FB.HediffCompProperties_FleshParasite">
        <spawnKind>Fingerspike</spawnKind>
        <tearInjury>Scratch</tearInjury>
        <minCoverageForSpawn>0.05</minCoverageForSpawn>
        <checkIntervalTicks>250</checkIntervalTicks>
        <spreads>
          <li>
            <severity>0.5</severity>
            <chance>1</chance>
          </li>
          <li>
            <severity>0.85</severity>
            <chance>0.35</chance>
          </li>
        </spreads>
      </li>
    </comps>
    <stages>
      <li>
        <label>embryo</label>
        <painOffset>0.03</painOffset>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <label>larva</label>
        <painOffset>0.06</painOffset>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>maturing</label>
        <painOffset>0.1</painOffset>
      </li>
    </stages>
  </HediffDef>
</Defs>
