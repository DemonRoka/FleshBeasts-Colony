  <!-- Common fleshbeast constant trunks -->
  <ThinkTreeDef Name="FB_FleshbeastBaseConstant" Abstract="True">
    <thinkRoot Class="FB.ThinkNode_FleshbeastBehaviorPriority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow">
          <subNodes>
            <li Class="FB.JobGiver_FleshbeastFleeResponse" />
            <li Class="FB.JobGiver_FleshbeastHuntAggressiveTargets" />
          </subNodes>
        </li>
        
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <ThinkTreeDef Name="FB_FleshbeastBaseConstantWithLordDuty" Abstract="True">
    <thinkRoot Class="FB.ThinkNode_FleshbeastBehaviorPriority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        
        <li Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow">
          <subNodes>
            <li Class="FB.JobGiver_FleshbeastFleeResponse" />
            <li Class="FB.JobGiver_FleshbeastHuntAggressiveTargets" />
          </subNodes>
        </li>
        <li Class="ThinkNode_ConditionalCanDoLordJobNow">
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>LordDutyConstant</treeDef>
            </li>
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- Vanilla-like fleshbeast tree used by standard colony fleshbeasts -->
  <ThinkTreeDef ParentName="FB_FleshbeastBaseMainWithMeleeThreat">
    <defName>FB_FleshbeastStandardMain</defName>
    <thinkRoot Class="FB.ThinkNode_FleshbeastBehaviorPriority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>
        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Fleshbeast_PreMain</insertTag>
        </li>
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>30</targetAcquireRadius>
          <targetKeepRadius>35</targetKeepRadius>
        </li>
        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Fleshbeast_PreWander</insertTag>
        </li>
        <li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="JobGiver_WanderAnywhere">
              <maxDanger>Deadly</maxDanger>
              <ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
            </li>
          </subNodes>
        </li>
        <li Class="JobGiver_IdleError" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <ThinkTreeDef ParentName="FB_FleshbeastBaseConstantWithLordDuty">
    <defName>FB_FleshbeastStandardConstant</defName>
  </ThinkTreeDef>
</Defs>
