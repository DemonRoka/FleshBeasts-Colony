<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Common fleshbeast main trunks -->
  <ThinkTreeDef Name="FB_FleshbeastBaseMain" Abstract="True">
    <thinkRoot Class="FB.ThinkNode_FleshbeastBehaviorPriority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_ConditionalMustKeepLyingDown">
          <subNodes>
            <li Class="ThinkNode_QueuedJob">
              <inBedOnly>true</inBedOnly>
            </li>
            <li Class="JobGiver_KeepLyingDown" />
          </subNodes>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>BurningResponse</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>MentalStateCritical</treeDef>
        </li>
        <li Class="ThinkNodeConditional_EscapingHoldingPlatform">
          <subNodes>
            <li Class="JobGiver_EscapingHoldingPlatform" />
          </subNodes>
        </li>
        
        <li Class="FB.JobGiver_FleshbeastFleeResponse" />
        <li Class="FB.JobGiver_FleshbeastHuntAggressiveTargets" />
        <li Class="ThinkNode_QueuedJob" />
        <li Class="ThinkNode_Subtree">
          <treeDef>MentalStateNonCritical</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>RopedPawn</treeDef>
        </li>
        <li Class="ThinkNode_ConditionalForcedGoto">
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>Misc</tagToGive>
              <subNodes>
                <li Class="JobGiver_ForcedGoto" />
              </subNodes>
            </li>
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

