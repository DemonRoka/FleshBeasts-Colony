<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Дерево мышления: FB_CargoTendrilProxyMain -->
  <ThinkTreeDef>
    <defName>FB_CargoTendrilProxyMain</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_ConditionalMustKeepLyingDown">
          <subNodes>
            <li Class="ThinkNode_QueuedJob">
              <inBedOnly>true</inBedOnly>
            </li>
            <li Class="JobGiver_KeepLyingDown" />
          </subNodes>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_QueuedJob" />
        <li Class="FB.JobGiver_DoConfiguredWork">
          <allowedWorkGivers>
            <li>DoctorRescue</li>
            <li>HaulToPortal</li>
            <li>LoadTransporters</li>
            <li>RearmTurrets</li>
            <li>Refuel</li>
            <li>UnloadCarriers</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">HaulToGeneBank</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">HaulToGrowthVat</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">HaulToSubcoreScanner</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">HaulToWastepackAtomizer</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">HaulToBiosculpterPod</li>
            <li MayRequire="Ludeon.RimWorld.Anomaly">TakeBioferriteOutOfHarvester</li>
            <li>DeliverResourcesToFrames</li>
            <li>DeliverResourcesToBlueprints</li>
            <li>HaulCorpses</li>
            <li>HaulGeneral</li>
          </allowedWorkGivers>
        </li>
        <li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="JobGiver_Idle" />
          </subNodes>
        </li>
        <li Class="JobGiver_IdleError" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
  <!-- Дерево мышления: FB_CargoTendrilProxyConstant -->
  <ThinkTreeDef>
    <defName>FB_CargoTendrilProxyConstant</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
</Defs>
