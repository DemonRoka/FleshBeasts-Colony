<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Дерево мышления: FB_ScrapmeldMain -->
  <ThinkTreeDef ParentName="FB_FleshbeastBaseMainWithMeleeThreatAndPlayerOrders">
    <defName>FB_ScrapmeldMain</defName>
    <thinkRoot Class="FB.ThinkNode_FleshbeastBehaviorPriority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>
        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Fleshbeast_PreMain</insertTag>
        </li>
        <li Class="JobGiver_SeekAllowedArea" />
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
          <allowTurrets>true</allowTurrets>
        </li>
        <li Class="FB.JobGiver_ScrapmeldCollectMechanoidCorpse" />
        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Fleshbeast_PreWander</insertTag>
        </li>
        <li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="JobGiver_WanderAnywhere">
              <maxDanger>Deadly</maxDanger>
              <ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
            </li>
          </subNodes>
        </li>
        <li Class="JobGiver_IdleError" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
  <!-- Дерево мышления: FB_ScrapmeldConstant -->
  <ThinkTreeDef ParentName="FB_FleshbeastBaseConstant">
    <defName>FB_ScrapmeldConstant</defName>
    <thinkRoot Class="FB.ThinkNode_FleshbeastBehaviorPriority">
      <subNodes>
        <li Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow">
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>JoinAutoJoinableCaravan</treeDef>
            </li>
            <li Class="JobGiver_ConfigurableHostilityResponse" />
          </subNodes>
        </li>
        <li Class="ThinkNode_ConditionalCanDoLordJobNow">
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>LordDutyConstant</treeDef>
            </li>
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
  <!-- Дерево мышления: FB_ScrapmeldNestlingMain -->
