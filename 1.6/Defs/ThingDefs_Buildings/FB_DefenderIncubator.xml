<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Постройка: Defender Incubator (FB_DefenderIncubator) -->
  <ThingDef ParentName="BuildingColonyFleshBaseAnimation">
    <defName>FB_DefenderIncubator</defName>
    <thingClass>FB.Building_FleshStructure</thingClass>
    <label>Defender Incubator</label>
    <description>A defensive incubator that periodically releases short-lived fleshbeast defenders on command or when a hostile enters its detection radius. It needs time to mature before it can produce defenders again.</description>
    <researchPrerequisites>
      <li>DefenderIncubatorResearch</li>
    </researchPrerequisites>
    <size>(2,2)</size>
    <statBases>
      <Beauty>-20</Beauty>
      <MaxHitPoints>300</MaxHitPoints>
    </statBases>
    <killedLeavingsRanges>
      <Meat_Twisted>20~50</Meat_Twisted>
    </killedLeavingsRanges>
    <forceLeavingsAllowed>true</forceLeavingsAllowed>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_Organic/DefenderIncubator/DefenderIncubator</texPath>
      <drawSize>(1.69,1.69)</drawSize>
    </graphicData>
    <comps>
      <li Class="FB.CompProperties_PawnSpawnerOnDemand">
        <pawnKindToSpawn>FB_StingmiteKind</pawnKindToSpawn>
        <pawnsToSpawn>4</pawnsToSpawn>
        <rechargeTicks>90000</rechargeTicks>
        <spawnRadius>3</spawnRadius>
        <hemogelCost>0</hemogelCost>
        <enemyDetectionRadius>20</enemyDetectionRadius>
        <enemyScanIntervalTicks>60</enemyScanIntervalTicks>
        <requireLineOfSight>false</requireLineOfSight>
        <randomPawnChance>0.05</randomPawnChance>
        <randomPawnKinds>
          <li>FB_FingerspikeGauntletKind</li>
        </randomPawnKinds>
        <iconPath>UI/Commands/ReleaseDefenders</iconPath>
        <gizmoLabel>FB_DefenderIncubator_ReleaseLabel</gizmoLabel>
        <gizmoDesc>FB_DefenderIncubator_ReleaseDesc</gizmoDesc>
        <gizmoRechargingDesc>FB_DefenderIncubator_RechargingDesc</gizmoRechargingDesc>
        <showThreatReleaseHint>true</showThreatReleaseHint>
      </li>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>1</hemogelPerHour>
      </li>
    </comps>
  </ThingDef>
</Defs>
