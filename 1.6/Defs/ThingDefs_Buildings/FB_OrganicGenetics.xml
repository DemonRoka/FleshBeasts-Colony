<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Постройка: gene reweaver cocoon (FB_GeneReweaverCocoon) -->
  <ThingDef>
    <defName>FB_GeneReweaverCocoon</defName>
    <label>gene reweaver cocoon</label>
    <thingClass>FB.ThingWithComps_FleshRaidTarget</thingClass>
    <category>Building</category>
    <description>A temporary cocoon that holds a carrier while a xenogerm prepared by the gene reweaver is implanted.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/FB_Organic/BiomassCocoon/BiomassCocoon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3, 1.3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>1.25</Flammability>
    </statBases>
    <fillPercent>0.5</fillPercent>
    <selectable>true</selectable>
    <building>
      <deconstructible>false</deconstructible>
      <repairable>false</repairable>
    </building>
    <comps>
      <li Class="FB.CompProperties_GeneReweaverCocoon">
        <ticksToComplete>42000</ticksToComplete>
        <completeEffecter>MeatExplosionSmall</completeEffecter>
        <destroyEffecter>MeatExplosionSmall</destroyEffecter>
      </li>
    </comps>
  </ThingDef>

  <!-- Постройка: genophage cocoon (FB_GenophageCocoon) -->
  <ThingDef ParentName="BuildingColonyFleshBase">
    <defName>FB_GenophageCocoon</defName>
    <label>genophage cocoon</label>
    <description>Extracts one to three random genes not yet held in the genome archive from a living donor and stores them there. The donor leaves the cocoon after the procedure and needs time for their genes to regrow.</description>
    <researchPrerequisites>
      <li>FB_OrganicGenetics</li>
    </researchPrerequisites>
    <thingClass>FB.Building_GenophageCocoon</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>260</MaxHitPoints>
      <Beauty>-18</Beauty>
      <Mass>12</Mass>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_Organic/GenophageCocoon/GenophageCocoon</texPath>
      <drawSize>(2.5,2.5)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/FB_Organic/GenophageCocoon/GenophageCocoon</uiIconPath>
    <comps>
      <li Class="FB.CompProperties_OverlayTexture">
        <texturePath>Things/Building/FB_Organic/GenophageCocoon/GenophageCocoonMembrane</texturePath>
        <altitudeLayer>Gas</altitudeLayer>
        <drawSize>(2.5,2.5)</drawSize>
      </li>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>0.6</hemogelPerHour>
      </li>
    </comps>
  </ThingDef>

  <!-- Постройка: genome archive (FB_GenomeArchive) -->
  <ThingDef ParentName="BuildingColonyFleshBase">
    <defName>FB_GenomeArchive</defName>
    <label>genome archive</label>
    <description>A living archive that separates genepacks into individual genes. Stores one copy of each gene for inspection and xenogerm creation by a gene reweaver.</description>
    <researchPrerequisites>
      <li>FB_OrganicGenetics</li>
    </researchPrerequisites>
    <thingClass>FB.Building_GenomeArchive</thingClass>
    <tickerType>Normal</tickerType>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <Beauty>-12</Beauty>
      <Mass>10</Mass>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_Organic/GenomeArchive/GenomeArchive</texPath>
      <drawSize>(2.3,2.3)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/FB_Organic/GenomeArchive/GenomeArchive</uiIconPath>
    <inspectorTabs>
      <li>FB.ITab_OrganicGeneArchiveContents</li>
    </inspectorTabs>
    <comps>
      <li Class="FB.CompProperties_OrganicGeneArchiveContainer">
        <maxCapacity>999999</maxCapacity>
      </li>
      <li Class="CompProperties_Power">
        <compClass>FB.CompSilentGeneArchivePower</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <showPowerNeededIfOff>false</showPowerNeededIfOff>
      </li>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>0.6</hemogelPerHour>
      </li>
    </comps>
  </ThingDef>

  <!-- Постройка: gene reweaver (FB_GeneReweaver) -->
  <ThingDef ParentName="BuildingColonyFleshBase">
  <defName>FB_GeneReweaver</defName>
  <label>gene reweaver</label>
  <description>Creates a xenogerm from archived genes, then grows a cocoon to implant it into a carrier.</description>
  <researchPrerequisites>
    <li>FB_OrganicGenetics</li>
  </researchPrerequisites>
  <thingClass>FB.Building_GeneReweaver</thingClass>
  <drawerType>MapMeshAndRealTime</drawerType>
  <size>(3,3)</size>
  <statBases>
    <MaxHitPoints>380</MaxHitPoints>
    <Beauty>-20</Beauty>
    <Mass>24</Mass>
  </statBases>
  <graphicData>
    <graphicClass>Graphic_Single</graphicClass>
    <texPath>Things/Building/FB_Organic/GeneReweaver/GeneReweaver</texPath>
    <drawSize>4</drawSize>
  </graphicData>
  <uiIconPath>Things/Building/FB_Organic/GeneReweaver/GeneReweaver</uiIconPath>
  <comps>
    <li Class="FB.CompProperties_GrowthStageOverlay">
      <altitudeLayer>Gas</altitudeLayer>
      <drawSize>(3,3)</drawSize>
      <stages>
        <li>
          <minProgress>0</minProgress>
          <texPath>Things/Building/FB_Organic/GeneReweaver/GeneReweaverGrowSegment_1</texPath>
        </li>
        <li>
          <minProgress>0.3</minProgress>
          <texPath>Things/Building/FB_Organic/GeneReweaver/GeneReweaverGrowSegment_2</texPath>
        </li>
        <li>
          <minProgress>0.8</minProgress>
          <texPath>Things/Building/FB_Organic/GeneReweaver/GeneReweaverGrowSegment_3</texPath>
        </li>
      </stages>
    </li>
    <li Class="FB.CompProperties_HemogelUpkeep">
      <hemogelPerHour>0.6</hemogelPerHour>
    </li>
  </comps>
</ThingDef>

  <!-- Постройка: gestation organoid (FB_GestationOrganoid) -->
  <ThingDef ParentName="BuildingColonyFleshBase">
    <defName>FB_GestationOrganoid</defName>
    <label>gestation organoid</label>
    <description>Grows offspring of the living donor's species, consuming hemogel. The donor neither ages nor hungers inside; a humanlike offspring's xenotype can be composed from archived genepacks.\n\nThe donor cannot be recovered. Each birth drains its reserves, and it dies when they are exhausted.</description>
    <researchPrerequisites>
      <li>FB_OrganicGenetics</li>
    </researchPrerequisites>
    <thingClass>FB.Building_FleshGestationOrganoid</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <size>(3,3)</size>
    <multipleInteractionCellOffsets>
      <li>(0,0,-2)</li>
      <li>(0,0,2)</li>
      <li>(-2,0,0)</li>
      <li>(2,0,0)</li>
    </multipleInteractionCellOffsets>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <Beauty>-22</Beauty>
      <Mass>26</Mass>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_Organic/GestationOrganoid/GestationOrganoid</texPath>
      <drawSize>4</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/FB_Organic/GestationOrganoid/GestationOrganoid</uiIconPath>
    <modExtensions>
      <li Class="FB.GestationOrganoidExtension">
        <ticksPerCycle>60000</ticksPerCycle>
        <maxBirths>10</maxBirths>
        <activeHemogelPerHour>1.5</activeHemogelPerHour>
      </li>
    </modExtensions>
    <comps>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>0.6</hemogelPerHour>
      </li>
    </comps>
  </ThingDef>

  <!-- Постройка: brood matrix (FB_BroodMatrix) -->
  <ThingDef ParentName="BuildingColonyFleshBase">
    <defName>FB_BroodMatrix</defName>
    <label>brood matrix</label>
    <description>Grows up to four children to age thirteen at eighty times the normal rate, consuming hemogel. Children receive skills, passions, traits, and genes from a living donor according to the inheritance settings. The donor ages rapidly and dies when their remaining lifetime is exhausted.\n\nOnly outsiders can serve as donors; pawns accepted by the flesh colony or grown in flesh are unsuitable. Without a donor, growth stops. Depleting the food reserve kills the capsule occupants.</description>
    <thingClass>FB.Building_FleshBroodMatrix</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <size>(2,2)</size>
    <multipleInteractionCellOffsets>
      <li>(0,0,-1)</li>
      <li>(1,0,2)</li>
      <li>(-1,0,1)</li>
      <li>(2,0,0)</li>
    </multipleInteractionCellOffsets>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
      <Beauty>-20</Beauty>
      <Mass>20</Mass>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_Organic/BroodMatrix/BroodMatrix</texPath>
      <drawSize>(2.5,2.5)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/FB_Organic/BroodMatrix/BroodMatrix</uiIconPath>
    <inspectorTabs>
      <li>FB.ITab_BroodMatrixInheritance</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>FB_BroodMatrixCultivation</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="FB.BroodMatrixExtension">
        <maxOccupantAgeYears>13</maxOccupantAgeYears>
        <ageTicksPerTick>80</ageTicksPerTick>
        <hemogelPerCapsulePerHour>0.4</hemogelPerCapsulePerHour>
        <hemogelPerDonorPerHour>0.3</hemogelPerDonorPerHour>
        <hemogelBufferHours>12</hemogelBufferHours>
        <childYearsPerDonor>6.5</childYearsPerDonor>
        <headDrawScale>0.8</headDrawScale>
      </li>
    </modExtensions>
    <comps>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>0.3</hemogelPerHour>
      </li>
    </comps>
  </ThingDef>

</Defs>
