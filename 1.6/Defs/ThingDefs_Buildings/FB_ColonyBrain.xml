<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Постройка: Colony Brain (FB_ColonyBrain) -->
  <ThingDef ParentName="BuildingColonyFleshBaseAnimation">
    <defName>FB_ColonyBrain</defName>
    <label>Colony Brain</label>
    <description>The neural command hub of a fleshmass colony. This twitching, bioelectric organ processes stimuli from across the colony’s living structures, issuing signals through fleshy tendrils and hemogel pulses. It grows in complexity with the colony itself, embodying its will and instinct.</description>
    <size>(3,3)</size>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <statBases>
      <Beauty>-30</Beauty>
    </statBases>
    <building>
      <isEdifice>true</isEdifice>
      <isInert>true</isInert>
      <isTargetable>true</isTargetable>
      <claimable>false</claimable>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <deconstructible>false</deconstructible>
      <destroyEffecter>FleshmassDestroyed</destroyEffecter>
    </building>
    <killedLeavingsRanges>
      <Meat_Twisted>150~250</Meat_Twisted>
    </killedLeavingsRanges>
    <forceLeavingsAllowed>true</forceLeavingsAllowed>
    <inspectorTabs>
      <li>FB.ITab_FleshbeastBills</li>
      <li>FB.ITab_FleshColonyMemory</li>
    </inspectorTabs>
    <comps>
      <li Class="FB.CompProperties_FleshAnimationManager">
        <animationAmplitude>0.02</animationAmplitude>
        <animationSideAmplitude>0.01</animationSideAmplitude>
        <baseAnimationSpeed>0.3</baseAnimationSpeed>
        <beatDurationTicks>20</beatDurationTicks>
        <animatedParts>
          <li>
            <texturePath>Things/Building/FB_Organic/ColonyBrain/ColonyBrainPart_1</texturePath>
            <positionOffset>(0, 0, 0)</positionOffset>
            <textureScale>2.0</textureScale>
            <animationAmplitude>0.05</animationAmplitude>
            <animationSideAmplitude>0.03</animationSideAmplitude>
            <animationInterval>0</animationInterval>
            <animationOffset>0.0</animationOffset>
            <altitudeLayer>2</altitudeLayer>
            <rotationAngle>0</rotationAngle>
            <beatDelay>0</beatDelay>
          </li>
          <li>
            <texturePath>Things/Building/FB_Organic/ColonyBrain/ColonyBrainPart_2</texturePath>
            <positionOffset>(0, 0, 0)</positionOffset>
            <textureScale>2.0</textureScale>
            <animationAmplitude>0</animationAmplitude>
            <animationSideAmplitude>0</animationSideAmplitude>
            <animationInterval>0</animationInterval>
            <animationOffset>0.0</animationOffset>
            <altitudeLayer>1</altitudeLayer>
            <rotationAngle>0</rotationAngle>
            <beatDelay>0</beatDelay>
          </li>
        </animatedParts>
      </li>
      <li Class="FB.CompProperties_CargoTendrilPawnHauling">
        <proxyPawnKind>FB_CargoTendrilProxyKind</proxyPawnKind>
        <maxActiveTendrils>10</maxActiveTendrils>
        <defaultActiveTendrils>0</defaultActiveTendrils>
        <hemogelPerTendrilPerHour>0.3</hemogelPerTendrilPerHour>
        <tendrilReach>7</tendrilReach>
        <anchorSearchRadius>4</anchorSearchRadius>
        <captureRadiusFromFlesh>5</captureRadiusFromFlesh>
        <routeSpacingFactor>0.85</routeSpacingFactor>
      </li>
      <li Class="FB.CompProperties_BuildingSpawner">
        <buildingDefs>
          <li>FB_ColonyEye</li>
        </buildingDefs>
        <terrainDefs>
          <li>FleshVeins</li>
          <li>Flesh</li>
        </terrainDefs>
        <spawnRadius>10</spawnRadius>
        <minBuildingCount>2</minBuildingCount>
        <spawnOnInitialSetup>false</spawnOnInitialSetup>
        <maintainMinimum>false</maintainMinimum>
        <clearLabel>FB_ClearEyesLabel</clearLabel>
        <clearIconPath>UI/Commands/RemoveEyes</clearIconPath>
      </li>
      <li Class="FB.CompProperties_FleshSummonPawn">
        <hemogelCost>0</hemogelCost>
        <jobDef>GotoMindControlled</jobDef>
        <jobDurationTicks>3600</jobDurationTicks>
        <maxApproachSearchRadius>50</maxApproachSearchRadius>
        <gizmoLabel>FB_FleshSummonPawnLabel</gizmoLabel>
        <gizmoDesc>FB_FleshSummonPawnDesc</gizmoDesc>
        <iconPath>UI/Commands/FleshCall</iconPath>
        <cooldownTicksRange>40000~50000</cooldownTicksRange>
        <rejectMessage>FB_InvalidTarget</rejectMessage>
      </li>
      <li Class="FB.CompProperties_FleshCocoonMutator">
        <hemogelCost>0</hemogelCost>
        <jobDef>GotoMindControlled</jobDef>
        <jobDurationTicks>5000</jobDurationTicks>
        <maxApproachSearchRadius>50</maxApproachSearchRadius>
        <terrainDefs>
          <li>FleshVeins</li>
          <li>Flesh</li>
        </terrainDefs>
        <cocoonDef>FB_BiomassCocoon</cocoonDef>
        <genesToAdd>
          <li>FB_HiveConstructor</li>
          <li>FB_Assimilator</li>
          <li>FB_OrganicArmor</li>
          <li>FB_PulsatingMold</li>
          <li>FB_Fragmentation</li>
          <li>FB_TriTendrils</li>
          <li>FB_DorsalSpines</li>
          <li>FB_MeatBloom</li>
          <li>FB_FleshMarshal</li>
          <li>FB_ReplicatorParasite</li>
          <li>FB_Scavenger</li>
          <li>FB_FleshbeastBody</li>
          <li>FB_Eater</li>
        </genesToAdd>
        <hediffDefs>
          <li>FB_AcceptanceOfFleshColony</li>
        </hediffDefs>
        <gizmoLabel>FB_FleshCocoonMutatorLabel</gizmoLabel>
        <gizmoDesc>FB_FleshCocoonMutatorDesc</gizmoDesc>
        <iconPath>UI/Abilities/CocoonFlesh</iconPath>
        <cooldownTicksRange>120000</cooldownTicksRange>
        <rejectMessage>FB_InvalidTarget</rejectMessage>
        <successFleckDef>PsycastPsychicEffect</successFleckDef>
        <allowDowned>false</allowDowned>
        <allowHumanoids>true</allowHumanoids>
      </li>
      <li Class="FB.CompProperties_FleshbeastBillExecutor">
        <checkIntervalTicks>250</checkIntervalTicks>
        <recipes>
          <li>FB_MergeTrispike</li>
          <li>FB_MergeToughspike</li>
          <li>FB_MergeBulbfreak</li>
          <li>FB_MergeDreadmeld</li>
          <li>FB_AssembleSegmentedBastion</li>
          <li>FB_AssembleAcidBroodmother</li>
          <li>FB_AssembleDevourer</li>
          <li>FB_GrowPsyphageFromHemogel</li>
        </recipes>
      </li>
      <li Class="FB.CompProperties_ColonyBrainNeuralResearch">
        <progressIntervalTicks>420</progressIntervalTicks>
        <researchPointsPerPulse>1.05</researchPointsPerPulse>
        <additionalHemogelPerHour>4</additionalHemogelPerHour>
        <gizmoLabel>FB_ColonyBrainNeuralActivity_Label</gizmoLabel>
        <gizmoDesc>FB_ColonyBrainNeuralActivity_Desc</gizmoDesc>
        <iconPath>UI/Commands/ColonyBrainNeuralActivity</iconPath>
      </li>
      <li Class="FB.CompProperties_BrainFleshResurrection">
        <requiredResearch>FB_FleshResurrection</requiredResearch>
        <jobDef>FB_FingerspikeResurrectCorpse</jobDef>
        <acceptanceHediff>FB_AcceptanceOfFleshColony</acceptanceHediff>
        <shellAdaptationHediff>FB_ShellAdaptation</shellAdaptationHediff>
        <biomassPartHediff>FB_ResurrectedBiomassPart</biomassPartHediff>
        <tentacleHediffDefName>Tentacle</tentacleHediffDefName>
        <commandIconPath>UI/Commands/BrainFleshResurrection</commandIconPath>
        <workTicks>300</workTicks>
        <tentacleMutationChance>0.5</tentacleMutationChance>
        <marketValuePerFingerspike>300</marketValuePerFingerspike>
      </li>
      <li Class="FB.CompProperties_BrainHemoghoulConversion">
        <requiredResearch>FB_HemoghoulReanimation</requiredResearch>
        <jobDef>FB_FingerspikeCreateHemoghoul</jobDef>
        <hemoghoulMutant>FB_Hemoghoul</hemoghoulMutant>
        <forcedBodyType>Hulk</forcedBodyType>
        <commandIconPath>UI/Commands/HemoghoulConversion</commandIconPath>
        <workTicks>300</workTicks>
        <marketValuePerFingerspike>300</marketValuePerFingerspike>
      </li>
      <li Class="FB.CompProperties_BrainFleshThrallConversion">
        <requiredResearch>FB_FleshThrallReanimation</requiredResearch>
        <jobDef>FB_FingerspikeCreateFleshThrall</jobDef>
        <fleshThrallHediff>FB_FleshThrall</fleshThrallHediff>
        <fleshThrallMutant>FB_FleshThrall</fleshThrallMutant>
        <commandIconPath>UI/Commands/FleshThrallConversion</commandIconPath>
        <workTicks>180</workTicks>
        <marketValuePerFingerspike>300</marketValuePerFingerspike>
      </li>
      <li Class="FB.CompProperties_BrainForcedFleshConversion">
        <requiredResearch>FB_FingerspikeImplantation</requiredResearch>
        <fingerspikeJobDef>FB_ForcedFleshConversionFingerspike</fingerspikeJobDef>
        <!-- Своим колонистам пальцешипов нужно вдвое меньше -->
        <colonistCostMultiplier>0.5</colonistCostMultiplier>
        <stasisHediff>FB_GraftmawSurgicalStasis</stasisHediff>
        <anesthesiaHediff>Anesthetic</anesthesiaHediff>
        <restraintMoteDefName>Mote_HarbingerTreeRoots</restraintMoteDefName>
        <anesthesiaRefreshTicks>2000</anesthesiaRefreshTicks>
        <biomassPartHediff>FB_ResurrectedBiomassPart</biomassPartHediff>
        <unrecruitableResultPawnKind>Toughspike</unrecruitableResultPawnKind>
        <commandIconPath>UI/Commands/ForcedFleshConversion</commandIconPath>
        <marketValuePerFingerspike>300</marketValuePerFingerspike>
        <treatmentQuality>0.8</treatmentQuality>
      </li>
      <li Class="FB.CompProperties_FleshColonyMemoryBrain">
        <requiredResearch>FB_ColonyMemoryArchive</requiredResearch>
        <reconstructionCost>500</reconstructionCost>
        <growthTicks>1000</growthTicks>
        <spawnRadius>5</spawnRadius>
        <depositMemoryJob>FB_DepositPersonalityInColonyMemory</depositMemoryJob>
        <depositMemoryWorkTicks>180</depositMemoryWorkTicks>
        <reconstructIconPath>UI/Commands/FleshMemoryReconstruct</reconstructIconPath>
        <deleteIconPath>UI/Commands/FleshMemoryDelete</deleteIconPath>
      </li>
      <li Class="FB.CompProperties_FleshbeastGroups">
        <maxGroups>16</maxGroups>
        <excludedPawnKinds>
          <li>FB_Sclerat</li>
        </excludedPawnKinds>
        <defendDurationTicks>10000</defendDurationTicks>
        <defendRadius>14</defendRadius>
        <returnRadius>8</returnRadius>
        <defendIconPath>UI/Commands/FleshGroupDefend</defendIconPath>
        <attackIconPath>UI/Commands/FleshGroupAttack</attackIconPath>
        <returnIconPath>UI/Commands/FleshGroupReturn</returnIconPath>
        <stopIconPath>UI/Commands/FleshGroupStop</stopIconPath>
        <tunnelIconPath>UI/Commands/FleshGroupTunnel</tunnelIconPath>
        <massZoneIconPath>UI/Commands/LoadFleshbeasts</massZoneIconPath>
        <digestCrippledIconPath>UI/Commands/FleshGroupDigestCrippled</digestCrippledIconPath>
        <selectIconPath>UI/Commands/SelectHeld</selectIconPath>
      </li>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>2</hemogelPerHour>
      </li>
    </comps>
  </ThingDef>
</Defs>
