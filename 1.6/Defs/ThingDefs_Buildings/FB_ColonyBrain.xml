<Defs>
  <!-- Постройка: Colony Brain (FB_ColonyBrain) -->
  <ThingDef ParentName="BuildingColonyFleshBaseAnimation">
    <defName>FB_ColonyBrain</defName>
    <label>Colony Brain</label>
    <description>The neural command hub of a fleshmass colony. This twitching, bioelectric organ processes stimuli from across the colony’s living structures, issuing signals through fleshy tendrils and hemogel pulses. It grows in complexity with the colony itself, embodying its will and instinct.</description>
    <size>(3,3)</size>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <statBases>
      <Beauty>-30</Beauty>
    </statBases>
    <building>
      <isEdifice>true</isEdifice>
      <isInert>true</isInert>
      <isTargetable>true</isTargetable>
      <claimable>false</claimable>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <deconstructible>false</deconstructible>
      <destroyEffecter>FleshmassDestroyed</destroyEffecter>
    </building>
    <killedLeavingsRanges>
      <Meat_Twisted>150~250</Meat_Twisted>
    </killedLeavingsRanges>
    <forceLeavingsAllowed>true</forceLeavingsAllowed>
    <inspectorTabs>
      <li>FB.ITab_FleshbeastBills</li>
      <li>FB.ITab_FleshColonyMemory</li>
    </inspectorTabs>
