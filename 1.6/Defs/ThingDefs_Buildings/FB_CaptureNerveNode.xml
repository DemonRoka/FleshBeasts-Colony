<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Building: capture nerve node (FB_CaptureNerveNode) -->
  <ThingDef ParentName="BuildingColonyFleshBase">
  <defName>FB_CaptureNerveNode</defName>
  <label>capture nerve node</label>
  <description>A small relay-organ of wet nerves and gripping reflex tissue. It links to the nearest colony heart and adds one shared grasping tendril slot. Without a heart, all capture nerve nodes on the map combine their slots into one autonomous capture pool.</description>
  <drawerType>MapMeshAndRealTime</drawerType>
  <size>(1,1)</size>
  <tickerType>Normal</tickerType>
  <statBases>
    <MaxHitPoints>180</MaxHitPoints>
    <Beauty>-12</Beauty>
    <Cleanliness>-3</Cleanliness>
    <Flammability>1.0</Flammability>
  </statBases>
  <graphicData>
    <graphicClass>Graphic_Single</graphicClass>
    <texPath>Things/Building/FB_Organic/CaptureNerveNode/CaptureNerveNode</texPath>
    <drawSize>1.5</drawSize>
    <damageData>
      <rect>(0.15, 0.15, 0.7, 0.7)</rect>
      <scratches>
        <li>Damage/FleshScratch1</li>
        <li>Damage/FleshScratch2</li>
        <li>Damage/FleshScratch3</li>
      </scratches>
    </damageData>
  </graphicData>
  <uiIconPath>Things/Building/FB_Organic/CaptureNerveNode/CaptureNerveNode</uiIconPath>
  <building>
    <expandHomeArea>false</expandHomeArea>
    <isTargetable>true</isTargetable>
    <ai_combatDangerous>true</ai_combatDangerous>
    <isEdifice>true</isEdifice>
    <isInert>true</isInert>
    <claimable>false</claimable>
    <deconstructible>false</deconstructible>
    <repairable>false</repairable>
    <destroyEffecter>FleshmassDestroyed</destroyEffecter>
  </building>
  <killedLeavingsRanges>
    <Meat_Twisted>35~55</Meat_Twisted>
  </killedLeavingsRanges>
  <forceLeavingsAllowed>true</forceLeavingsAllowed>
  <inspectorTabs>
    <li>FB.ITab_GraspingTendrilPolicy</li>
  </inspectorTabs>
  <comps>
    <li Class="FB.CompProperties_CaptureNerveNode">
      <extraCaptureSlots>1</extraCaptureSlots>
    </li>
    <li Class="FB.CompProperties_BuildingSpawnThing">
      <thingDefToSpawn>FB_GraspingTendrils</thingDefToSpawn>
      <allowedTerrains>
        <li>Flesh</li>
        <li>FleshVeins</li>
        <li>RootFlesh</li>
        <li>RootFleshVeins</li>
      </allowedTerrains>
      <gizmoLabel>FB_RaiseGraspingTendrilsLabel</gizmoLabel>
      <gizmoDesc>FB_RaiseGraspingTendrilsDesc</gizmoDesc>
      <iconPath>UI/Abilities/RaiseGraspingTendrils</iconPath>
      <rejectMessage>FB_CannotPlaceTendrilsHere</rejectMessage>
      <enabledByDefault>true</enabledByDefault>
      <maxSimultaneous>1</maxSimultaneous>
      <searchRadius>60</searchRadius>
      <checkIntervalTicks>1000</checkIntervalTicks>
      <researchToAvoidFriendly>FB_FriendlyCaptureRecognition</researchToAvoidFriendly>
    </li>
    <li Class="FB.CompProperties_HemogelUpkeep">
      <hemogelPerHour>0.7</hemogelPerHour>
    </li>
  </comps>
</ThingDef>

  <!-- Building: capture nerve node embryo (FB_CaptureNerveNodeEmbryo) -->
  <ThingDef ParentName="EmbryoStructureBase">
    <defName>FB_CaptureNerveNodeEmbryo</defName>
    <label>capture nerve node embryo</label>
    <description>An immature nerve relay that will grow into a capture nerve node.</description>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Beauty>-10</Beauty>
    </statBases>
    <comps>
      <li Class="FB.CompProperties_EmbryoGrowth">
        <totalMaturationTicks>7000</totalMaturationTicks>
        <targetDef>FB_CaptureNerveNode</targetDef>
      </li>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>0.3</hemogelPerHour>
      </li>
    </comps>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_Organic/CaptureNerveNode/CaptureNerveNodeEmbryo</texPath>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
