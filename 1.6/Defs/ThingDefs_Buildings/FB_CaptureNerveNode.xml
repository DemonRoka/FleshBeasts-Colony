<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Building: grasping tendrils (FB_GraspingTendrils) -->
  <ThingDef ParentName="BuildingColonyFleshBase">
    <defName>FB_GraspingTendrils</defName>
    <label>Grasping Tendrils</label>
    <description>A sudden bloom of living tendrils forced up through the ground. They coil and cinch without warning, hauling the victim into a choking knot of flesh and root-fibers. The colony's hunger works quickly; once the grip is spent, the growth withers and sinks back into the soil.</description>
    <thingClass>FB.Building_FleshCapturePlatform</thingClass>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Beauty>-25</Beauty>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Plaseholder</texPath>
      <drawSize>(0.01,0.01)</drawSize>
    </graphicData>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <building>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps Inherit="False">
      <li Class="FB.CompProperties_CaptureRootDrawer">
        <moteDefSmall>Mote_HarbingerTreeRoots</moteDefSmall>
        <moteDefLarge>Mote_FleshRootsSide</moteDefLarge>
        <updateEveryTicks>100</updateEveryTicks>
        <hemogelPerHourWhileHolding>10</hemogelPerHourWhileHolding>
        <tentacleDamageEveryTicks>500</tentacleDamageEveryTicks>
        <tentacleHitChance>0.7</tentacleHitChance>
        <tentacleDamageMin>4</tentacleDamageMin>
        <tentacleDamageMax>8</tentacleDamageMax>
        <killAndVanishOnEject>true</killAndVanishOnEject>
      </li>
      <li Class="FB.CompProperties_FleshRegeneration">
        <ticksPerHeal>500</ticksPerHeal>
        <ticksPerDamage>2000</ticksPerDamage>
        <hemogelPerHeal>0</hemogelPerHeal>
      </li>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>0.1</hemogelPerHour>
      </li>
    </comps>
  </ThingDef>

  <!-- Building: capture nerve node (FB_CaptureNerveNode) -->
  <ThingDef ParentName="BuildingColonyFleshBase">
    <defName>FB_CaptureNerveNode</defName>
    <label>capture nerve node</label>
    <description>A small relay-organ of wet nerves and gripping reflex tissue. It links to the nearest colony heart, expands the heart's grasping tendril capacity, and relays that heart's tendril commands.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <Beauty>-12</Beauty>
      <Cleanliness>-3</Cleanliness>
      <Flammability>1.0</Flammability>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_Organic/CaptureNerveNode/CaptureNerveNode</texPath>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0.15, 0.15, 0.7, 0.7)</rect>
        <scratches>
          <li>Damage/FleshScratch1</li>
          <li>Damage/FleshScratch2</li>
          <li>Damage/FleshScratch3</li>
        </scratches>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/FB_Organic/CaptureNerveNode/CaptureNerveNode</uiIconPath>
    <building>
      <expandHomeArea>false</expandHomeArea>
      <isTargetable>true</isTargetable>
      <ai_combatDangerous>true</ai_combatDangerous>
      <isEdifice>true</isEdifice>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <repairable>false</repairable>
      <destroyEffecter>FleshmassDestroyed</destroyEffecter>
    </building>
    <killedLeavingsRanges>
      <Meat_Twisted>35~55</Meat_Twisted>
    </killedLeavingsRanges>
    <forceLeavingsAllowed>true</forceLeavingsAllowed>
    <inspectorTabs>
      <li>FB.ITab_GraspingTendrilPolicy</li>
    </inspectorTabs>
    <comps>
      <li Class="FB.CompProperties_CaptureNerveNode">
        <extraCaptureSlots>1</extraCaptureSlots>
      </li>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>0.7</hemogelPerHour>
      </li>
    </comps>
  </ThingDef>

  <!-- Building: capture nerve node embryo (FB_CaptureNerveNodeEmbryo) -->
  <ThingDef ParentName="EmbryoStructureBase">
    <defName>FB_CaptureNerveNodeEmbryo</defName>
    <label>capture nerve node embryo</label>
    <description>An immature nerve relay that will grow into a capture nerve node.</description>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Beauty>-10</Beauty>
    </statBases>
    <comps>
      <li Class="FB.CompProperties_EmbryoGrowth">
        <totalMaturationTicks>7000</totalMaturationTicks>
        <targetDef>FB_CaptureNerveNode</targetDef>
      </li>
      <li Class="FB.CompProperties_HemogelUpkeep">
        <hemogelPerHour>0.3</hemogelPerHour>
      </li>
    </comps>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_Organic/CaptureNerveNode/CaptureNerveNodeEmbryo</texPath>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
