<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Постройка: flesh colony pit burrow (FB_PitBurrow) -->
  <ThingDef ParentName="CraterBase">
    <defName>FB_PitBurrow</defName>
    <label>flesh colony pit burrow</label>
    <description>A small hole to a flesh colony undercave.</description>
    <thingClass>FB.FB_PitBurrow</thingClass>
    <size>(3,3)</size>
    <tickerType>Normal</tickerType>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/FB_PitBurrow/FB_PitBurrow</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <building>
      <uninstallWork>2500</uninstallWork>
    </building>
    <portal>
      <pocketMapGenerator>FleshColonyUndercave</pocketMapGenerator>
      <exitDef>FB_CaveExit</exitDef>
      <enteredLetterLabel>Flesh colony lair</enteredLetterLabel>
      <enteredLetterText>Entered flesh colony undercave. Destroy structures.</enteredLetterText>
      <enteredLetterDef>ThreatBig</enteredLetterDef>
      <traverseSound>TraversePitGate</traverseSound>
    </portal>
  </ThingDef>

  <!-- База построек: RotColonyStructureBase -->
  <ThingDef Abstract="True" Name="RotColonyStructureBase" ParentName="BuildingBase">
    <thingClass>FB.Building_FleshStructure</thingClass>
    <rotatable>false</rotatable>
    <fillPercent>0.5</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <Flammability>0.5</Flammability>
      <WorkToBuild>1000</WorkToBuild>
    </statBases>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
    <comps>
    </comps>
  </ThingDef>

  <!-- Постройка: rotten colony brain (FB_RotColonyBrain) -->
  <ThingDef ParentName="RotColonyStructureBase">
    <defName>FB_RotColonyBrain</defName>
    <label>rotten colony brain</label>
    <description>A decayed remnant of a fleshmass colony brain. Its organic components have rotted away, leaving it useless.</description>
    <graphicData>
      <texPath>Things/Building/FB_Organic/ColonyBrain/RotColonyBrain</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="FB.CompProperties_FleshmassSpawnOnDeath">
        <spawnPawnKindDefs>
          <li>FB_Rotlarva</li>
        </spawnPawnKindDefs>
        <spawnPawnCountRange>3~5</spawnPawnCountRange>
      </li>
    </comps>
  </ThingDef>

  <!-- Постройка: rotten colony heart (FB_RotColonyHeart) -->
  <ThingDef ParentName="RotColonyStructureBase">
    <defName>FB_RotColonyHeart</defName>
    <label>rotten colony heart</label>
    <description>A decayed remnant of a fleshmass colony heart. Its organic components have rotted away, leaving it useless.</description>
    <graphicData>
      <texPath>Things/Building/FB_Organic/ColonyHeart/RotColonyHeart</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="FB.CompProperties_FleshmassSpawnOnDeath">
        <spawnPawnKindDefs>
          <li>FB_Rotlarva</li>
        </spawnPawnKindDefs>
        <spawnPawnCountRange>3~5</spawnPawnCountRange>
      </li>
    </comps>
  </ThingDef>
</Defs>
