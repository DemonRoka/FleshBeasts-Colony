<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorldObjectDef>
    <defName>FB_FleshMoonWorldObject</defName>
    <label>flesh moon</label>
    <description>A living orbital mass tethered to the colony by the celestial umbilicus.</description>
    <worldObjectClass>FB.FB_FleshMoonWorldObject</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>true</canHaveMap>
    <canBePlayerHome>true</canBePlayerHome>
    <treatAsPlayerHome>true</treatAsPlayerHome>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>true</selectable>
    <texture>World/WorldObjects/FleshMoonSurface</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/FleshMoonSurface</expandingIconTexture>
    <expandingIconDrawSize>1.2</expandingIconDrawSize>
    <expandingIconPriority>20</expandingIconPriority>
    <mapGenerator>FB_FleshMoonPocket</mapGenerator>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>FB_FleshMoonStartingSettlement</defName>
    <label>flesh moon</label>
    <description>A hidden scenario handoff object used to let the flesh moon be generated as the player's first map.</description>
    <worldObjectClass>FB.FB_FleshMoonStartingSettlement</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>true</canHaveMap>
    <canBePlayerHome>true</canBePlayerHome>
    <treatAsPlayerHome>true</treatAsPlayerHome>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>false</selectable>
    <texture>World/WorldObjects/FleshMoonStartingSettlement</texture>
    <mapGenerator>FB_FleshMoonPocket</mapGenerator>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>FB_FleshMoonSurfaceAnchor</defName>
    <label>flesh moon anchor</label>
    <description>A surface point pierced by the flesh moon's celestial umbilicus.</description>
    <worldObjectClass>FB.FB_FleshMoonSurfaceAnchorWorldObject</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>true</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>false</selectable>
    <texture>World/WorldObjects/FleshMoonSurfaceAnchor</texture>
    <mapGenerator>Encounter</mapGenerator>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>FB_FleshMoonCrashSite</defName>
    <label>fallen flesh moon</label>
    <description>A surface scar where the starving flesh moon fell and burst across the terrain.</description>
    <worldObjectClass>FB.FB_FleshMoonCrashSiteWorldObject</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>true</canHaveMap>
    <canBePlayerHome>true</canBePlayerHome>
    <treatAsPlayerHome>true</treatAsPlayerHome>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>true</selectable>
    <texture>World/WorldObjects/FleshMoonCrashSite</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/FleshMoonCrashSite</expandingIconTexture>
    <expandingIconDrawSize>1.2</expandingIconDrawSize>
    <expandingIconPriority>22</expandingIconPriority>
    <mapGenerator>Encounter</mapGenerator>
  </WorldObjectDef>
</Defs>
