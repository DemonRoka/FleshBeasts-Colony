<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WorldObjectDef>
    <defName>FB_FleshBulwark</defName>
    <label>flesh bulwark</label>
    <description>A knot of reinforced tissue that strengthens its own and nearby territories against burn parties. Does not increase hemogel extraction.</description>
    <worldObjectClass>FB.WorldObject_FleshWorldFacility</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>false</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>true</selectable>
    <texture>World/WorldObjects/FleshBulwark</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/FleshBulwark</expandingIconTexture>
    <expandingIconDrawSize>0.85</expandingIconDrawSize>
    <expandingIconPriority>16</expandingIconPriority>
    <modExtensions>
      <li Class="FB.FleshWorldFacilityDefModExtension">
        <category>Production</category>
        <cost>30000</cost>
        <tileProductionMultiplier>1</tileProductionMultiplier>
        <defenseRating>45</defenseRating>
        <defenseRadius>3</defenseRadius>
      </li>
    </modExtensions>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>FB_FleshTreeNursery</defName>
    <label>flesh grove</label>
    <description>Dense growths of flesh trees and flesh leaves that accelerate hemogel extraction from local biomass. Increased extraction depletes the territory faster.</description>
    <worldObjectClass>FB.WorldObject_FleshWorldFacility</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>false</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>true</selectable>
    <texture>World/WorldObjects/FleshTreeNursery</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/FleshTreeNursery</expandingIconTexture>
    <expandingIconDrawSize>0.85</expandingIconDrawSize>
    <expandingIconPriority>16</expandingIconPriority>
    <modExtensions>
      <li Class="FB.FleshWorldFacilityDefModExtension">
        <category>Production</category>
        <cost>20000</cost>
        <tileProductionMultiplier>3</tileProductionMultiplier>
      </li>
    </modExtensions>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>FB_FleshRiverSiphon</defName>
    <label>great river siphon</label>
    <description>A large feeding organ that increases hemogel extraction by rivers, lakes, and coasts. Requires access to water and depletes the territory faster.</description>
    <worldObjectClass>FB.WorldObject_FleshWorldFacility</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>false</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>true</selectable>
    <texture>World/WorldObjects/FleshRiverSiphon</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/FleshRiverSiphon</expandingIconTexture>
    <expandingIconDrawSize>0.85</expandingIconDrawSize>
    <expandingIconPriority>16</expandingIconPriority>
    <modExtensions>
      <li Class="FB.FleshWorldFacilityDefModExtension">
        <category>Production</category>
        <cost>35000</cost>
        <tileProductionMultiplier>4</tileProductionMultiplier>
        <requiresWaterTile>true</requiresWaterTile>
      </li>
    </modExtensions>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>FB_FleshAmbushCamp</defName>
    <label>flesh ambush camp</label>
    <description>A patch of flesh adapted to ambush animals and passing caravans. Increases hemogel extraction and gathers trophies for delivery to an outpost.</description>
    <worldObjectClass>FB.WorldObject_FleshWorldFacility</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>false</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>true</selectable>
    <texture>World/WorldObjects/FleshAmbushCamp</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/FleshAmbushCamp</expandingIconTexture>
    <expandingIconDrawSize>0.85</expandingIconDrawSize>
    <expandingIconPriority>16</expandingIconPriority>
    <inspectorTabs>
      <li>FB.WITab_FleshFacilityStorage</li>
    </inspectorTabs>
    <modExtensions>
      <li Class="FB.FleshWorldFacilityDefModExtension">
        <category>Ambush</category>
        <cost>25000</cost>
        <tileProductionMultiplier>2</tileProductionMultiplier>
        <generatesAmbushLoot>true</generatesAmbushLoot>
        <ambushLootMinTicks>120000</ambushLootMinTicks>
        <ambushLootMaxTicks>300000</ambushLootMaxTicks>
        <ambushOpenTileRadius>3</ambushOpenTileRadius>
        <ambushNearbySettlementRadius>40</ambushNearbySettlementRadius>
        <ambushHaulMinStacks>3</ambushHaulMinStacks>
        <ambushHaulMaxStacks>9</ambushHaulMaxStacks>
        <ambushHaulMinValue>350</ambushHaulMinValue>
        <ambushHaulMaxValue>2600</ambushHaulMaxValue>
      </li>
    </modExtensions>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>FB_FleshCrustCorer</defName>
    <label>deep borer</label>
    <description>A drilling organ that extracts minerals at the expense of local biomass. Rapidly depletes the territory; hills and mountains yield rare resources more often.</description>
    <worldObjectClass>FB.WorldObject_FleshWorldFacility</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>false</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>true</selectable>
    <texture>World/WorldObjects/FleshCrustCorer</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/FleshCrustCorer</expandingIconTexture>
    <expandingIconDrawSize>0.85</expandingIconDrawSize>
    <expandingIconPriority>16</expandingIconPriority>
    <inspectorTabs>
      <li>FB.WITab_FleshFacilityStorage</li>
    </inspectorTabs>
    <modExtensions>
      <li Class="FB.FleshWorldFacilityDefModExtension">
        <category>Production</category>
        <cost>35000</cost>
        <tileProductionMultiplier>1</tileProductionMultiplier>
        <producesMinerals>true</producesMinerals>
        <mineralDrainPerHour>500</mineralDrainPerHour>
        <mineralBiomassPerPortion>6000</mineralBiomassPerPortion>
        <mineralYieldFactor>1</mineralYieldFactor>
        <mineralRarityPerHillOffset>1</mineralRarityPerHillOffset>
        <mineralExcludedThings>
          <li>Bioferrite</li>
        </mineralExcludedThings>
      </li>
    </modExtensions>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>FB_FleshTunnelNexus</defName>
    <label>tunnel node</label>
    <description>Grows a distant tunnel maw for instant travel by caravans and war packs. Can grow a new passage after the old one is collapsed.</description>
    <worldObjectClass>FB.WorldObject_FleshTunnelNexus</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <canHaveMap>false</canHaveMap>
    <validLaunchTarget>false</validLaunchTarget>
    <selectable>true</selectable>
    <texture>World/WorldObjects/FleshTunnelNexus</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/FleshTunnelNexus</expandingIconTexture>
    <expandingIconDrawSize>0.85</expandingIconDrawSize>
    <expandingIconPriority>16</expandingIconPriority>
    <modExtensions>
      <li Class="FB.FleshWorldFacilityDefModExtension">
        <category>Production</category>
        <cost>60000</cost>
        <tileProductionMultiplier>1</tileProductionMultiplier>
        <tunnelNexus>true</tunnelNexus>
        <tunnelHemogelPerWorldTile>1200</tunnelHemogelPerWorldTile>
        <tunnelMinimumGrowCost>12000</tunnelMinimumGrowCost>
        <tunnelGrowTicksPerWorldTile>1200</tunnelGrowTicksPerWorldTile>
        <tunnelMinimumGrowTicks>5000</tunnelMinimumGrowTicks>
        <tunnelMouthDef>FB_FleshTunnelMouth</tunnelMouthDef>
      </li>
    </modExtensions>
  </WorldObjectDef>

</Defs>
